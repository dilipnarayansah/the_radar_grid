rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Listings: Public read, validated create, restricted update/delete
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.data.title is string 
                    && request.resource.data.title.size() > 0;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || resource.data.authorId == null);
    }

    // RFQs: Public read, validated create, restricted update/delete
    match /rfqs/{rfqId} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.data.title is string 
                    && request.resource.data.title.size() > 0;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || resource.data.authorId == null);
    }

    // Profiles: Public read, owner-only write
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // Chats: Authenticated access
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    match /system/status {
      allow read: if true;
      allow write: if false;
    }
  }
}
